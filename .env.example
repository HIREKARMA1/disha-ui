# Copy to .env / .env.local for local development.
# On Vercel → Project Settings → Environment Variables, use the Production names below.

# -----------------------------------------------------------------------------
# API (client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.disha.hirekarma.in
NEXT_PUBLIC_API_VERSION=v1

# -----------------------------------------------------------------------------
# App URL (OAuth redirect base — must match Supabase redirect allow-list)
# On Vercel you can set APP_URL (no NEXT_PUBLIC_) OR NEXT_PUBLIC_APP_URL.
# If unset, next.config.js falls back to https://$VERCEL_URL.
# -----------------------------------------------------------------------------
APP_URL=https://disha.hirekarma.in
# NEXT_PUBLIC_APP_URL=https://disha.hirekarma.in

NEXT_PUBLIC_APP_NAME=HireKarma

# -----------------------------------------------------------------------------
# Google auth via Supabase (student OAuth only)
# Set these on Vercel WITHOUT NEXT_PUBLIC_ (recommended — avoids the
# "Remove the public framework prefix" warning). Publishable key is safe
# to expose; never add the Supabase service_role secret to the frontend.
# next.config.js maps them into the browser bundle for Google Sign-In.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional legacy names (still supported):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
